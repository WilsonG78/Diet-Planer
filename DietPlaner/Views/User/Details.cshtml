@model DietPlaner.Models.User

@{
    ViewData["Title"] = "User Details";
}

<h1>User Details</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Name)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Surname)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Surname)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.LoginName)</dt>
    <dd class="col-sm-10"><code>@Html.DisplayFor(m => m.LoginName)</code></dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.UserRole)</dt>
    <dd class="col-sm-10">
        <span class="badge @(Model.UserRole.ToString() == "Admin" ? "bg-danger" : Model.UserRole.ToString() == "Nurse" ? "bg-primary" : "bg-success")">
            @Html.DisplayFor(m => m.UserRole)
        </span>
    </dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.ApiToken)</dt>
    <dd class="col-sm-10"><code>@Html.DisplayFor(m => m.ApiToken)</code></dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
